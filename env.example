# Copy to .env for local Next.js. On Vercel, set these in Project → Settings → Environment Variables.

# Vercel Storage often already has these three — the app maps them automatically:
# POSTGRES_URL, PRISMA_DATABASE_URL, DATABASE_URL
# Optional aliases if you add them by hand:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Leave AUTH_URL unset on Vercel until poultrytechapp.com DNS points at Vercel.
# AUTH_URL="https://your-app.vercel.app"

# Forgot password emails (Resend free tier). Required for reset links to arrive.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="PoultryTech <onboarding@resend.dev>"

# Never set this on the live site. Local tunnel demos only.
# AUTH_DEV_BYPASS="true"
