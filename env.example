# Copy to .env for local Next.js. On Vercel, set these in Project → Settings → Environment Variables.

# Prisma Postgres / Neon: pooled string for the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Direct string for prisma migrate (Prisma Postgres shows this separately).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="https://poultrytechapp.com"

# Never set this on the live site. Local tunnel demos only.
# AUTH_DEV_BYPASS="true"
