generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TECHNICIAN
  ADMIN
  GROWER
  VETERINARIAN
}

enum FlockSex {
  MALE
  FEMALE
  STRAIGHT_RUN
  UNKNOWN
}

enum FlockStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MortalityCause {
  UNKNOWN
  EARLY_MORTALITY
  LEG_ISSUES
  FLIP_OVER
  HEART_RELATED
  RESPIRATORY
  ENTERITIS
  COCCIDIOSIS
  HEAT_STRESS
  COLD_STRESS
  EQUIPMENT_ISSUE
  SMOTHERING
  PREDATOR
  CULL
  YOLK_INFECTION
  BACTERIA
  ESCHERICHIA_COLI
  OTHER
}

enum LitterEventType {
  FULL_LITTER_CLEANOUT
  PARTIAL_LITTER_CLEANOUT
  DE_CAKING
  WINDROWING
  TILL
  LITTER_TREATMENT
  TOP_DRESSING
  COMPOST_REMOVAL
  OTHER
}

enum VisitType {
  ROUTINE_SERVICE
  PLACEMENT
  SEVEN_DAY
  WEIGH_DAY
  VACCINATION
  MEDICATION
  EQUIPMENT_ISSUE
  MORTALITY_INVESTIGATION
  PRE_CATCH
  OTHER
}

enum IssueCategory {
  FEED
  WATER
  VENTILATION
  COOLING_SYSTEM
  HEATING_SYSTEM
  CONTROLLER
  ELECTRICAL
  STRUCTURE
  BIOSECURITY
  BIRD_HEALTH
  LITTER
  OTHER
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  MONITORING
  SCHEDULED
  RESOLVED
}

enum MeasurementUnit {
  IMPERIAL
  METRIC
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TECHNICIAN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farms            Farm[]
  settings         UserSettings?
  mortalityEntries DailyMortality[]
}

model UserSettings {
  id                         String          @id @default(cuid())
  userId                     String          @unique
  dailyMortalityWarningPct   Float           @default(0.15)
  dailyMortalityCriticalPct  Float           @default(0.3)
  sevenDayMortalityWarningPct Float          @default(1.0)
  sevenDayMortalityCriticalPct Float         @default(2.0)
  alertRisingThreeDays       Boolean         @default(true)
  missingMortalityAlertTime  String          @default("14:00")
  preferredUnits             MeasurementUnit @default(IMPERIAL)
  defaultMarketAgeDays       Int             @default(52)
  notifyEmail                Boolean         @default(false)
  notifyInApp                Boolean         @default(true)
  ageBandThresholdsJson      String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Farm {
  id             String    @id @default(cuid())
  userId         String
  farmName       String
  growerName     String
  farmNumber     String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  phoneNumber    String?
  email          String?
  numberOfHouses Int       @default(0)
  notes          String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  houses       House[]
  flocks       Flock[]
  litterEvents LitterEvent[]
  visits       FarmVisit[]
  issues       FarmIssue[]
  generatorLogs GeneratorLog[]
  followUpCompletions FollowUpCompletion[]
  lastFeedOrders LastFeedOrder[]

  @@index([userId])
  @@index([farmName])
  @@index([growerName])
}

model House {
  id                       String    @id @default(cuid())
  farmId                   String
  houseNumber              Int
  squareFootage            Float
  houseLength              Float?
  houseWidth               Float?
  totalFanCFM              Float?
  numberOfFans             Int?
  coolingPadSquareFootage  Float?
  feederType               String?
  drinkerType              String?
  controllerType           String?
  yearBuilt                Int?
  minVentilationCFM        Float?
  fanCycleOnSeconds        Int?
  fanCycleOffSeconds       Int?
  notes                    String?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  farm         Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  houseFlocks  HouseFlock[]
  litterEvents LitterEvent[]
  issues       FarmIssue[]
  lfoInventories LastFeedOrderHouseInventory[]

  @@unique([farmId, houseNumber])
  @@index([farmId])
}

model Flock {
  id                        String      @id @default(cuid())
  farmId                    String
  flockNumber               String
  flockName                 String?
  placementDate             DateTime
  projectedCatchDate        DateTime?
  actualCatchDate           DateTime?
  processingPlant           String?
  birdType                  String?
  sex                       FlockSex    @default(STRAIGHT_RUN)
  initialBirdCount          Int
  flockStatus               FlockStatus @default(ACTIVE)
  targetMarketAge           Int?
  targetMarketWeight        Float?
  /** Avg bird weight (lb) from last sample / weigh. */
  weightSampleLbs           Float?
  weightSampleDate          DateTime?   @db.Date
  /** Daily gain used for catch projections (lb/day). */
  growthRateLbsPerDay       Float?
  /** Settlement sheet: market age (days). */
  settlementMarketAgeInDays Int?
  /** Settlement sheet: average weight (lb). */
  settlementWeightLbs       Float?
  /** Settlement sheet: feed conversion. */
  settlementFeedConversion  Float?
  /** Settlement sheet: adjusted feed conversion. */
  settlementAdjustedFeedConversion Float?
  /** Settlement sheet: good pounds sold. */
  settlementGoodPoundsSold  Float?
  /** Settlement sheet: place/rank (1, 2, 3…). */
  settlementNo              Int?
  litterConditionAtPlacement String?
  notes                     String?
  deletedAt                 DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  farm           Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  houseFlocks    HouseFlock[]
  feedDeliveries FeedDelivery[]
  visits         FarmVisit[]
  issues         FarmIssue[]
  followUpCompletions FollowUpCompletion[]
  lastFeedOrders LastFeedOrder[]

  @@index([farmId])
  @@index([flockStatus])
  @@index([flockNumber])
}

model HouseFlock {
  id                      String   @id @default(cuid())
  flockId                 String
  houseId                 String
  placedBirdCount         Int
  processingPlant         String?
  finalBirdCount          Int?
  finalAverageWeight      Float?
  totalFeedDelivered      Float?
  feedConversion          Float?
  totalMortality          Int?
  mortalityPercentage     Float?
  condemnationPercentage  Float?
  livabilityPercentage    Float?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  flock        Flock              @relation(fields: [flockId], references: [id], onDelete: Cascade)
  house        House              @relation(fields: [houseId], references: [id], onDelete: Cascade)
  mortalities  DailyMortality[]
  feedDeliveries FeedDelivery[]
  performance  FlockPerformance?

  @@unique([flockId, houseId])
  @@index([flockId])
  @@index([houseId])
}

model DailyMortality {
  id                   String          @id @default(cuid())
  houseFlockId         String
  mortalityDate        DateTime        @db.Date
  birdAgeInDays        Int
  dailyMortalityCount  Int             @default(0)
  cullCount            Int             @default(0)
  totalDailyLoss       Int             @default(0)
  mortalityCause       MortalityCause  @default(UNKNOWN)
  comments             String?
  enteredByUserId      String?
  isDraft              Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  houseFlock HouseFlock @relation(fields: [houseFlockId], references: [id], onDelete: Cascade)
  enteredBy  User?      @relation(fields: [enteredByUserId], references: [id], onDelete: SetNull)

  @@unique([houseFlockId, mortalityDate])
  @@index([mortalityDate])
  @@index([houseFlockId])
}

model FeedDelivery {
  id              String   @id @default(cuid())
  flockId         String?
  houseFlockId    String?
  deliveryDate    DateTime @db.Date
  feedType        String?
  feedMill        String?
  ticketNumber    String?
  poundsDelivered Float
  tonsDelivered   Float
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  flock      Flock?      @relation(fields: [flockId], references: [id], onDelete: Cascade)
  houseFlock HouseFlock? @relation(fields: [houseFlockId], references: [id], onDelete: Cascade)

  @@index([flockId])
  @@index([houseFlockId])
  @@index([deliveryDate])
}

model LastFeedOrder {
  id               String   @id @default(cuid())
  farmId           String
  flockId          String
  orderDate        DateTime @db.Date
  /** Lbs feed per bird per day (used for hourly consumption). */
  consumptionRate  Float    @default(0.45)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  farm             Farm                          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  flock            Flock                         @relation(fields: [flockId], references: [id], onDelete: Cascade)
  houseInventories LastFeedOrderHouseInventory[]

  @@index([farmId])
  @@index([flockId])
  @@index([orderDate])
}

model LastFeedOrderHouseInventory {
  id              String    @id @default(cuid())
  lastFeedOrderId String
  houseId         String
  binAPounds      Float     @default(0)
  binBPounds      Float     @default(0)
  /** When feeders come back up; feed off is 6 hours before this. */
  feedUpAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lastFeedOrder LastFeedOrder @relation(fields: [lastFeedOrderId], references: [id], onDelete: Cascade)
  house         House         @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@unique([lastFeedOrderId, houseId])
  @@index([lastFeedOrderId])
  @@index([houseId])
}

model FlockPerformance {
  id                      String    @id @default(cuid())
  houseFlockId            String    @unique
  marketAgeInDays         Int?
  averageLiveWeight       Float?
  totalLiveWeight         Float?
  feedConversion          Float?
  adjustedFeedConversion  Float?
  livabilityPercentage    Float?
  mortalityPercentage     Float?
  condemnationPercentage  Float?
  settlementDate          DateTime?
  settlementNotes         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  houseFlock HouseFlock @relation(fields: [houseFlockId], references: [id], onDelete: Cascade)
}

model LitterEvent {
  id         String          @id @default(cuid())
  farmId     String
  houseId    String?
  eventDate  DateTime        @db.Date
  eventType  LitterEventType
  litterDepth Float?
  contractor String?
  cost       Float?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  farm  Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  house House? @relation(fields: [houseId], references: [id], onDelete: SetNull)

  @@index([farmId])
  @@index([eventDate])
}

model FarmVisit {
  id                   String    @id @default(cuid())
  farmId               String
  flockId              String?
  visitDate            DateTime  @db.Date
  birdAgeInDays        Int?
  visitType            VisitType @default(ROUTINE_SERVICE)
  generalBirdCondition String?
  activityLevel        String?
  uniformity           String?
  litterCondition      String?
  waterConsumption     String?
  feedInventory        String?
  temperature          Float?
  humidity             Float?
  staticPressure       Float?
  notes                String?
  followUpRequired     Boolean   @default(false)
  followUpDate         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  farm  Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  flock Flock? @relation(fields: [flockId], references: [id], onDelete: SetNull)

  @@index([farmId])
  @@index([visitDate])
}

model FollowUpCompletion {
  id            String   @id @default(cuid())
  farmId        String
  flockId       String?
  scheduledDate DateTime @db.Date
  label         String
  completedAt   DateTime @default(now())
  completedByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farm  Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  flock Flock? @relation(fields: [flockId], references: [id], onDelete: SetNull)

  @@unique([farmId, scheduledDate, label])
  @@index([farmId])
  @@index([flockId])
  @@index([scheduledDate])
}

model FarmIssue {
  id               String        @id @default(cuid())
  farmId           String
  houseId          String?
  flockId          String?
  dateReported     DateTime      @db.Date
  category         IssueCategory
  priority         IssuePriority @default(MEDIUM)
  description      String
  correctiveAction String?
  assignedTo       String?
  status           IssueStatus   @default(OPEN)
  resolvedDate     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  farm  Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  house House? @relation(fields: [houseId], references: [id], onDelete: SetNull)
  flock Flock? @relation(fields: [flockId], references: [id], onDelete: SetNull)

  @@index([farmId])
  @@index([status])
  @@index([priority])
}

/** Hour-meter readings for farm generators (Gen 1–4). */
model GeneratorLog {
  id        String   @id @default(cuid())
  farmId    String
  logDate   DateTime @db.Date
  gen1Hours Float
  gen2Hours Float
  gen3Hours Float
  gen4Hours Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([logDate])
}
